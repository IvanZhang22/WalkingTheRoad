# ================================================================
# 阶跃星辰 Coding Plan（当前启用）
# 在 MODEL_API_KEY= 后粘贴你自己的 STEP_API_KEY。
# step-router-v1 只能使用下方 Step Plan 的 base URL。
# ================================================================
MODEL_PROVIDER=stepfun
MODEL_API_KEY=
MODEL_BASE_URL=https://api.stepfun.com/step_plan/v1
MODEL_NAME=step-3.5-flash
MODEL_THINKING=disabled

# ================================================================
# DeepSeek 备用方案（当前全部注释；如需切换，取消注释本块，
# 并注释上方五行 MODEL_* 配置。）
# ================================================================
# MODEL_PROVIDER=deepseek
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash
# MODEL_THINKING=disabled

APP_MODE=live
MODEL_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=300000
MULTIMODAL_CONNECT_TIMEOUT_SECONDS=10
MULTIMODAL_READ_TIMEOUT_SECONDS=120
MULTIMODAL_MAX_REDIRECTS=3

# ================================================================
# 对外服务鉴权（v2.0 清小搭/OpenAI 兼容接口）
# 这是调用本 Agent 的密钥，必须与上方 MODEL_API_KEY 不同。
# 部署到 Vercel 后，在项目环境变量中同样配置该项。
# ================================================================
AGENT_API_KEY=
