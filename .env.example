# ================================================================
# 阶跃星辰 Coding Plan（当前启用）
# 在 MODEL_API_KEY= 后粘贴你自己的 STEP_API_KEY。
# step-router-v1 只能使用下方 Step Plan 的 base URL。
# ================================================================
MODEL_PROVIDER=stepfun
MODEL_API_KEY=
MODEL_BASE_URL=https://api.stepfun.com/step_plan/v1
MODEL_NAME=step-3.5-flash
MODEL_THINKING=disabled

# ================================================================
# DeepSeek 备用方案（当前全部注释；如需切换，取消注释本块，
# 并注释上方五行 MODEL_* 配置。）
# ================================================================
# MODEL_PROVIDER=deepseek
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash
# MODEL_THINKING=disabled

APP_MODE=live
MODEL_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=20
MAX_DOCUMENT_CHARS=300000
MULTIMODAL_CONNECT_TIMEOUT_SECONDS=10
MULTIMODAL_READ_TIMEOUT_SECONDS=120
MULTIMODAL_MAX_REDIRECTS=3

# 阶跃音频文件识别（返回分句级毫秒时间戳）。
# STEPFUN_ASR_API_KEY 留空时，若 MODEL_PROVIDER=stepfun，会复用 MODEL_API_KEY。
# 请勿提交真实 Key；截图中出现过的 Key 必须先在阶跃控制台轮换。
ASR_PROVIDER=stepfun
STEPFUN_ASR_API_KEY=
STEPFUN_ASR_BASE_URL=https://api.stepfun.com/v1
STEPFUN_ASR_MODEL=step-asr-1.1
STEPFUN_ASR_REQUEST_TIMEOUT_SECONDS=30
STEPFUN_ASR_POLL_TIMEOUT_SECONDS=300
STEPFUN_ASR_POLL_INTERVAL_SECONDS=2

# 如需高置信音频自动进入 W3，把 ASR_PROVIDER 改为 deepgram 并填写下方 Key。
# Deepgram 直接返回分句时间戳和置信度；Key 只放服务端环境变量。
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=zh-CN
DEEPGRAM_DIARIZE_MODEL=latest
DEEPGRAM_TIMEOUT_SECONDS=120

# 百度通用文字识别（含位置），用于图片和无文字层的扫描 PDF。
# 需要在百度智能云创建 OCR 应用，AK/SK 只放服务端环境变量。
OCR_PROVIDER=baidu
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_BASE_URL=https://aip.baidubce.com
BAIDU_OCR_ENDPOINT_PATH=/rest/2.0/ocr/v1/general
BAIDU_OCR_TIMEOUT_SECONDS=60
BAIDU_OCR_MAX_PAGES=20

# ================================================================
# 对外服务鉴权（v2.0 清小搭/OpenAI 兼容接口）
# 这是调用本 Agent 的密钥，必须与上方 MODEL_API_KEY 不同。
# 部署到 Vercel 后，在项目环境变量中同样配置该项。
# ================================================================
AGENT_API_KEY=
