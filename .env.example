# ================================================================
# OpenRouter 免绑卡演示方案（免费模型每日额度有限，不建议直接处理敏感材料）。
# ================================================================
MODEL_PROVIDER=openrouter
MODEL_API_KEY=
OPENROUTER_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openrouter/free
MODEL_THINKING=disabled

# ================================================================
# DeepSeek 备用方案（当前全部注释；如需切换，取消注释本块，
# 并注释上方五行 MODEL_* 配置。）
# ================================================================
# MODEL_PROVIDER=deepseek
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash
# MODEL_THINKING=disabled

# 阶跃备用方案需要单独注册阶跃账号并创建 API Key。
# MODEL_PROVIDER=stepfun
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.stepfun.com/step_plan/v1
# MODEL_NAME=step-3.5-flash
# MODEL_THINKING=disabled

# Vercel AI Gateway 备用方案，需要账户完成银行卡验证。
# MODEL_PROVIDER=vercel
# MODEL_API_KEY=
# AI_GATEWAY_API_KEY=
# MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# MODEL_NAME=openai/gpt-5.4-mini
# MODEL_THINKING=disabled

APP_MODE=live
MODEL_TIMEOUT_SECONDS=120
# 网页小文件直接进入 Function；大文件会浏览器直传 Vercel Blob。
MAX_UPLOAD_MB=100
MAX_DOCUMENT_CHARS=300000
MULTIMODAL_CONNECT_TIMEOUT_SECONDS=10
MULTIMODAL_READ_TIMEOUT_SECONDS=120
MULTIMODAL_MAX_REDIRECTS=3

# 阶跃音频文件识别（返回分句级毫秒时间戳）。
# STEPFUN_ASR_API_KEY 留空时，若 MODEL_PROVIDER=stepfun，会复用 MODEL_API_KEY。
# 请勿提交真实 Key；截图中出现过的 Key 必须先在阶跃控制台轮换。
# ASR_PROVIDER=stepfun
STEPFUN_ASR_API_KEY=
STEPFUN_ASR_BASE_URL=https://api.stepfun.com/v1
STEPFUN_ASR_MODEL=step-asr-1.1
STEPFUN_ASR_REQUEST_TIMEOUT_SECONDS=30
STEPFUN_ASR_POLL_TIMEOUT_SECONDS=300
STEPFUN_ASR_POLL_INTERVAL_SECONDS=2

# 阶跃文件 ASR 只接收公网 URL。腾讯云部署时，设置本服务的 HTTPS 公网根地址，
# 系统会将已获授权的音频临时中转给 ASR；任务结束即撤销随机 URL。
# m4a/webm 需服务器安装 ffmpeg，示例：ASR_RELAY_PUBLIC_BASE_URL=https://62.234.95.211
ASR_RELAY_PUBLIC_BASE_URL=
ASR_RELAY_TTL_SECONDS=600
ASR_RELAY_FFMPEG_PATH=ffmpeg

# 如需高置信音频自动进入 W3，把 ASR_PROVIDER 改为 deepgram 并填写下方 Key。
# Deepgram 直接返回分句时间戳和置信度；Key 只放服务端环境变量。
# 默认关闭；配置有效的 Deepgram Key 后改为 deepgram，或配置阶跃 ASR 后改为 stepfun。
ASR_PROVIDER=disabled
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=zh-CN
DEEPGRAM_DIARIZE_MODEL=latest
DEEPGRAM_TIMEOUT_SECONDS=120

# 百度 PP-OCRv6（控制台显示名；API 路径仍为 pp_ocrv5），用于图片和扫描 PDF。
# 需要在百度智能云创建 OCR 应用，AK/SK 只放服务端环境变量。
# 默认关闭；配置有效的百度 OCR AK/SK 后改为 baidu。
OCR_PROVIDER=disabled
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_BASE_URL=https://aip.baidubce.com
BAIDU_OCR_ENDPOINT_PATH=/rest/2.0/ocr/v1/pp_ocrv5
BAIDU_OCR_TIMEOUT_SECONDS=60
BAIDU_OCR_MAX_PAGES=20

# Vercel Blob 大文件直传。把项目连接到 Public Blob Store 后由 Vercel 自动注入。
# 文件识别完成后默认自动删除临时 Blob。
BLOB_READ_WRITE_TOKEN=
BLOB_CLEANUP_ENABLED=true

# 对话状态 SQLite 路径。留空时本地写入 data/；Vercel 自动使用可写但临时的 /tmp。
# 若部署环境提供持久化可写卷，可在服务端配置为该卷上的绝对路径。
CONVERSATION_DATABASE_PATH=

# ================================================================
# 对外服务鉴权（v2.0 清小搭/OpenAI 兼容接口）
# 这是调用本 Agent 的密钥，必须与上方 MODEL_API_KEY 不同。
# 部署到 Vercel 后，在项目环境变量中同样配置该项。
# ================================================================
AGENT_API_KEY=
